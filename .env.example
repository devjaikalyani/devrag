# ── LLM (Claude first) ────────────────────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MODEL_PRIMARY=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5
# Optional override for the hardest tasks, e.g. claude-opus-4-8
MODEL_ARCHITECT=
# auto = pick the first provider with a key (anthropic > groq > mistral > ollama)
LLM_PROVIDER=auto

# ── Fallback providers (all optional) ─────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ── GitHub (needed for issue mode: clone, fork, PR) ───
GITHUB_TOKEN=
# PR-mode runs are refused on repos your token does not own unless you set
# this to true. Only enable it for repos you have permission to contribute to;
# unsolicited automated PRs violate GitHub's Acceptable Use Policies.
ALLOW_THIRD_PARTY_REPOS=false

# ── Embedding models (HuggingFace, run locally) ───────
EMBEDDING_MODEL=microsoft/codebert-base
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Torch threads for the bulk-embedding worker. 0 = auto (half the logical
# cores). Bulk ingestion embeds in a separate process because multi-thread
# torch cannot share a process with FAISS/sklearn on Intel Mac.
EMBED_THREADS=0

# ── Retrieval ─────────────────────────────────────────
FAISS_INDEX_PATH=data/processed/faiss_index
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
FAITHFULNESS_THRESHOLD=0.5

# ── Agent ─────────────────────────────────────────────
MAX_RETRIES=5
SANDBOX_TIMEOUT=120
CLONE_DIR=/tmp/devrag_repos
ENABLE_SELF_REVIEW=true
ENABLE_HIERARCHICAL_PLANNING=true
ENABLE_COMPLEXITY_ROUTING=true

# ── Billing (Razorpay) ────────────────────────────────
# Keys: https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Domestic (INR: UPI, cards, netbanking) works out of the box; for USD,
# enable International Payments in the Razorpay dashboard.
# Leave blank to run without billing (everything defaults to the free tier).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (dashboard -> Webhooks -> payment.captured -> /billing/webhook)
RAZORPAY_WEBHOOK_SECRET=

# ── MLflow ────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=devrag

# ── API ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001

# ── Security (set these in production) ────────────────
# Comma-separated allowed origins. Leave as * for local dev.
ALLOWED_ORIGINS=*
# If set, all API requests (except /health, /docs) require X-API-Key header.
# Set the same value in the frontend as NEXT_PUBLIC_API_KEY.
API_KEY=

# ── Frontend env vars (Next.js — baked in at build time) ──
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_MLFLOW_URL=http://localhost:5000
NEXT_PUBLIC_API_KEY=
